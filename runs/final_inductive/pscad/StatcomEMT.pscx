            <param name="anchor" value="0" />
            <param name="full_font" value="Tahoma, 12world" />
            <param name="lock" value="false" />
          </paramlist>
        </Gfx>
        <paramlist>
          <param name="lock_style" value="3" />
          <param name="lock_cx" value="0" />
          <param name="lock_cy" value="0" />
        </paramlist>
      </graphics>
      <form w="320" h="400" splitter="60" category-width="180" help-width="490">
        <category name="Configuration">
          <cond><![CDATA[true]]></cond>
          <parameter type="Text" name="Name" desc="Name of the component" group="" allowemptystr="true">
            <value><![CDATA[]]></value>
          </parameter>
        </category>
        <category name="Electrical and control">
          <cond><![CDATA[true]]></cond>
          <parameter type="Real" name="Freq" desc="Freq" group="" dim="1" content_type="Literal" intent="Input" min="-1e+308" max="1e+308" animate="false">
            <value><![CDATA[60.0]]></value>
          </parameter>
          <parameter type="Real" name="Vbase" desc="Vbase" group="" dim="1" content_type="Literal" intent="Input" min="-1e+308" max="1e+308" animate="false">
            <value><![CDATA[230.0]]></value>
          </parameter>
          <parameter type="Real" name="Vop" desc="Vop" group="" dim="1" content_type="Literal" intent="Input" min="-1e+308" max="1e+308" animate="false">
            <value><![CDATA[0.8686743378639222]]></value>
          </parameter>
          <parameter type="Real" name="Ibase" desc="Ibase" group="" dim="1" content_type="Literal" intent="Input" min="-1e+308" max="1e+308" animate="false">
            <value><![CDATA[0.25102185616940254]]></value>
          </parameter>
          <parameter type="Real" name="Iq0" desc="Iq0" group="" dim="1" content_type="Literal" intent="Input" min="-1e+308" max="1e+308" animate="false">
            <value><![CDATA[-0.2302358792960337]]></value>
          </parameter>
          <parameter type="Real" name="Droop" desc="Droop" group="" dim="1" content_type="Literal" intent="Input" min="-1e+308" max="1e+308" animate="false">
            <value><![CDATA[0.05]]></value>
          </parameter>
          <parameter type="Real" name="Tau" desc="Tau" group="" dim="1" content_type="Literal" intent="Input" min="-1e+308" max="1e+308" animate="false">
            <value><![CDATA[0.02]]></value>
          </parameter>
          <parameter type="Real" name="Vfloor" desc="Vfloor" group="" dim="1" content_type="Literal" intent="Input" min="-1e+308" max="1e+308" animate="false">
            <value><![CDATA[0.05]]></value>
          </parameter>
          <parameter type="Real" name="Enable" desc="Enable" group="" dim="1" content_type="Literal" intent="Input" min="-1e+308" max="1e+308" animate="false">
            <value><![CDATA[0.3]]></value>
          </parameter>
        </category>
      </form>
      <script>
        <segment name="Dsdyn" classid="CoreSegment" id="1929061564"><![CDATA[#BEGIN
      ENABCCIN($A,$SS) = .TRUE.
      ENABCCIN($B,$SS) = .TRUE.
      ENABCCIN($C,$SS) = .TRUE.
#ENDBEGIN
#STORAGE REAL:4
#LOCAL INTEGER K
#LOCAL REAL VA0
#LOCAL REAL VB0
#LOCAL REAL VC0
#LOCAL REAL ALPHA
#LOCAL REAL BETA
#LOCAL REAL THETA
#LOCAL REAL VDNEW
#LOCAL REAL VQNEW
#LOCAL REAL MAGN
#LOCAL REAL TARGET
#LOCAL REAL PEAK
#LOCAL REAL ANG
      K = NSTORF
      NSTORF = NSTORF + 4
      IF (TIMEZERO) THEN
        STORF(K) = 0.0
        STORF(K+1) = 0.0
        STORF(K+2) = 0.0
        STORF(K+3) = 0.0
      ENDIF
      VA0 = $VDC:A:0
      VB0 = $VDC:B:0
      VC0 = $VDC:C:0
      ALPHA = (2.0*VA0-VB0-VC0)/3.0
      BETA = (VB0-VC0)/SQRT(3.0)
      THETA = TWO_PI*$Freq*TIME
      VDNEW = ALPHA*COS(THETA)+BETA*SIN(THETA)
      VQNEW = -ALPHA*SIN(THETA)+BETA*COS(THETA)
      STORF(K) = STORF(K)+(1.0-EXP(-DELT/0.01))*
     + (VDNEW-STORF(K))
      STORF(K+1) = STORF(K+1)+(1.0-EXP(-DELT/0.01))*
     + (VQNEW-STORF(K+1))
      MAGN = SQRT(STORF(K)**2+STORF(K+1)**2)
      $Vmeas = MAGN/($Vbase*SQRT(2.0/3.0))
      IF ($Vmeas .GT. $Vfloor) THEN
        STORF(K+3) = ATAN2(STORF(K+1),STORF(K))
      ENDIF
      TARGET = $Iq0+($Vop-$Vmeas)/$Droop
      TARGET = MAX(-1.0,MIN(1.0,TARGET))
      IF (TIME .LT. $Enable) TARGET = 0.0
      STORF(K+2) = STORF(K+2)+(1.0-EXP(-DELT/$Tau))*
     + (TARGET-STORF(K+2))
      $Iq = MAX(-1.0,MIN(1.0,STORF(K+2)))
! Advance the phase estimate by one electrical solution step.
      ANG = THETA+STORF(K+3)+TWO_PI*$Freq*DELT
      PEAK = SQRT(2.0)*$Ibase*$Iq
      $Ia = PEAK*SIN(ANG)
      $Ib = PEAK*SIN(ANG-TWO_PI/3.0)
      $Ic = PEAK*SIN(ANG+TWO_PI/3.0)
      CCIN($A,$SS) = CCIN($A,$SS)+$Ia
      CCIN($B,$SS) = CCIN($B,$SS)+$Ib
      CCIN($C,$SS) = CCIN($C,$SS)+$Ic
]]></segment>
      </script>
    </Definition>
